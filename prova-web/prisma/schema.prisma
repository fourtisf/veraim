// Database schema for Prova.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A wallet that signed in with "Connect wallet".
model User {
  id              String   @id @default(cuid())
  wallet          String   @unique // lowercase 0x address
  createdAt       DateTime @default(now())
  telegramChatId  String?
  telegramLinkCode String? @unique // one-time code for t.me/<bot>?start=<code>

  runs     Run[]
  watches  Watch[]
  alerts   Alert[]
  agents   Agent[]
  apiKeys  ApiKey[]
  quotes   Quote[]
  payments Payment[]
  webhooks Webhook[]
}

model Agent {
  id             String   @id @default(cuid())
  seq            Int      @unique @default(autoincrement()) // numeric id used onchain
  slug           String   @unique
  name           String
  tagline        String
  category       String
  ticker         String
  model          String   // key from config/models.ts
  instructions   String
  tools          String[]
  gradingMode    String   // "verdict24h" | "price7d" | "none"
  pricePerRunUsd Float    @default(0.05)
  openingBuy     String?
  tokenAddress   String?  // agent token (linked by its creator after launch)
  tokenSymbol    String?
  marketCapUsd   Float?   // refreshed by the worker from DexScreener
  priceUsd       Float?
  priceChange24h Float?
  registeredTx   String?  // creator registered on ProvaRuns
  tokenTx        String?  // token registered on ProvaRuns
  official       Boolean  @default(false) // built by Prova
  hidden         Boolean  @default(false) // hidden by an admin
  creatorId      String?
  creator        User?    @relation(fields: [creatorId], references: [id])
  createdAt      DateTime @default(now())

  calls    Call[]
  runs     Run[]
  watches  Watch[]
  alerts   Alert[]
  quotes   Quote[]
  payments Payment[]
  buybacks Buyback[]
}

// One answer from an agent. If it contains a gradable claim it is hashed,
// sealed onchain, and graded after gradesAt.
model Call {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  input       String
  output      String
  claimJson   String?   // canonical JSON of the claim that was hashed
  claimLabel  String?   // short human label, e.g. "BUNDLED" or "$ORBIO LONG · 7d"
  subject     String?   // token address the claim is about
  entryJson   String?   // price/liquidity snapshot at call time
  claimHash   String?   @unique
  sealTx      String?
  sealedAt    DateTime?
  gradesAt    DateTime?
  status      String    @default("ungraded") // ungraded | open | hit | miss | void
  weight      Float     @default(1) // thin-liquidity calls count for less
  gradedAt    DateTime?
  outcomeJson String?
  gradeTx     String?
  alertedAt   DateTime?
  hookSealAt  DateTime? // webhook "call.sealed" delivered
  hookGradeAt DateTime? // webhook "call.graded" delivered
  createdAt   DateTime  @default(now())

  run Run?

  @@index([agentId, createdAt])
  @@index([status, gradesAt])
  @@index([createdAt])
}

model Run {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  paid      Boolean  @default(false)
  amountUsd Float    @default(0)
  viaApi    Boolean  @default(false)
  callId    String?  @unique
  call      Call?    @relation(fields: [callId], references: [id])
  createdAt DateTime @default(now())

  @@index([agentId, userId])
  @@index([agentId, createdAt])
}

model Watch {
  userId  String
  agentId String
  user    User   @relation(fields: [userId], references: [id])
  agent   Agent  @relation(fields: [agentId], references: [id])

  @@id([userId, agentId])
}

model Alert {
  userId  String
  agentId String
  user    User   @relation(fields: [userId], references: [id])
  agent   Agent  @relation(fields: [agentId], references: [id])

  @@id([userId, agentId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  prefix     String    // first characters, shown in the UI
  hash       String    @unique // sha256 of the full key
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// Worker bookkeeping (e.g. Telegram update offset, last run times).
model KeyValue {
  key   String @id
  value String
}

model Waitlist {
  id            String   @id @default(cuid())
  emailOrWallet String   @unique
  source        String?  // "wallet", "launch" or "cta"
  createdAt     DateTime @default(now())

  @@map("waitlist")
}

// A price quote for paid runs. Its id (a bytes32 hex) is the payment reference sent onchain.
model Quote {
  id        String   @id // 0x… bytes32 ref
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  quantity  Int
  asset     String   // "ETH" | "USDG"
  amount    String   // smallest units (wei / USDG 6 decimals)
  amountUsd Float
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A confirmed onchain payment for runs (RunsPaid event on ProvaRuns).
model Payment {
  id        String   @id @default(cuid())
  ref       String   @unique
  txHash    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  asset     String
  amount    String
  amountUsd Float
  quantity  Int
  createdAt DateTime @default(now())

  @@index([userId, agentId])
}

// An executed buyback-and-burn (BuybackBurned event).
model Buyback {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  txHash       String   @unique
  asset        String
  amountIn     String
  amountUsd    Float
  tokensBurned String
  createdAt    DateTime @default(now())
}

// Signed webhooks: calls of agents on the owner's watchlist are POSTed here.
model Webhook {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  url       String
  secret    String
  failures  Int       @default(0)
  lastError String?
  lastOkAt  DateTime?
  disabled  Boolean   @default(false)
  createdAt DateTime  @default(now())
}
