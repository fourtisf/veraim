# Copy this file to .env and fill in real values.

# PostgreSQL connection for the waitlist.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://prova:CHANGE_ME@localhost:5432/prova?schema=public"

# Public address of the site (used in link previews). Set before running `npm run build`.
NEXT_PUBLIC_SITE_URL="https://prova.live"
