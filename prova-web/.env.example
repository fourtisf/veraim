# Copy this file to .env and fill in real values. Lines starting with # are notes.

# ---------- Required ----------

# PostgreSQL database. Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://veraim:CHANGE_ME@localhost:5432/veraim?schema=public"

# Public address of the site. Set before running `npm run build`.
NEXT_PUBLIC_SITE_URL="https://veraim.xyz"

# Random secret that signs wallet sessions. Make one with:  openssl rand -hex 32
SESSION_SECRET=""

# Wallets that can open /admin (comma separated, any case).
ADMIN_WALLETS=""

# ---------- AI models (at least one) ----------

# Claude models (Anthropic API key from console.anthropic.com). Used by the official agents.
ANTHROPIC_API_KEY=""
# Other models (GPT, Llama, DeepSeek) through OpenRouter (openrouter.ai/keys).
OPENROUTER_API_KEY=""
# Optional: change which exact model each builder option uses.
# MODEL_CLAUDE_SONNET="claude-sonnet-5"
# Claude via OpenRouter, used when ANTHROPIC_API_KEY is empty:
# MODEL_CLAUDE_SONNET_OPENROUTER="anthropic/claude-sonnet-5"
# MODEL_GPT="openai/gpt-5-mini"
# MODEL_LLAMA_70B="meta-llama/llama-3.3-70b-instruct"
# MODEL_DEEPSEEK="deepseek/deepseek-chat"

# ---------- Onchain sealing (Robinhood Chain) ----------

# robinhood (mainnet, chain 4663) or robinhoodTestnet (chain 46630)
CHAIN="robinhood"
# Optional: your own RPC URL (the public one is rate-limited)
RPC_URL=""
# Private key of a NEW wallet used only for sealing. It pays gas, so keep a little ETH on it.
SEALER_PRIVATE_KEY=""
# Addresses printed by `npm run contract:deploy`
SEAL_CONTRACT=""
RUNS_CONTRACT=""
# Wallet that receives Veraim's 10% of paid runs (set BEFORE deploying VeraimRuns).
# Official agents' 60% creator share also goes here.
TREASURY_ADDRESS=""
# USDG on Robinhood Chain (mainnet default below; testnet: 0x7E955252E15c84f5768B83c41a71F9eba181802F)
USDG_ADDRESS="0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168"
# Explorer used for "sealed ↗" links
EXPLORER_URL="https://robinhoodchain.blockscout.com"

# ---------- Buybacks ----------
# Uniswap v3 SwapRouter02-compatible router and WETH on Robinhood Chain. Buybacks stay off until both are set.
# Set SWAP_ROUTER before `npm run contract:deploy` (or run it again afterwards) so the router is allowed onchain.
SWAP_ROUTER=""
WETH_ADDRESS=""
# BUYBACK_MIN_USD=5              # buy back once an agent's reserve is worth at least this
# BUYBACK_SLIPPAGE=0.05          # max 5% worse than the market price
# BUYBACK_EVERY_MINUTES=60

# ---------- Optional ----------

# Telegram alerts: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""   # without the @, e.g. VeraimAlertsBot

# X mentions tool (X API bearer token)
X_BEARER_TOKEN=""

# Waitlist confirmation emails, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=""
MAIL_FROM="Veraim <hello@veraim.xyz>"

# Cookie-free analytics (self-hosted Umami)
NEXT_PUBLIC_UMAMI_SRC=""          # e.g. https://analytics.veraim.xyz/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Product rules
# MIN_LIQUIDITY_USD=10000         # calls on thinner tokens count half
# RUNS_PER_HOUR_PER_WALLET=20
# RUNS_PER_HOUR_PER_IP=40
# MAX_RUNS_PER_DAY=2000           # total runs per day across everyone (protects your AI bill)

# Autopilot: the official agents analyse the biggest live tokens on their own, spread over the
# day, so their track records fill up. Each run costs AI credits. 0 = off.
AUTOPILOT_RUNS_PER_AGENT_PER_DAY=0
# Optional: token addresses (comma separated) to always include, e.g. if the explorer's list is down.
# AUTOPILOT_TOKENS="0x...,0x..."
